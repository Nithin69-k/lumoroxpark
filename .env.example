# Copy these into Vercel → Project Settings → Environment Variables
# (and into a local .env for `npm run dev`).
#
# Anything prefixed with VITE_ is baked into the browser bundle at BUILD time,
# so it must be present in Vercel before the build runs. Everything else is
# read at runtime by SSR / server functions.

# --- Public site URL (canonical links, Open Graph, sitemap, robots.txt) ---
VITE_SITE_URL="https://your-app.vercel.app"

# --- Lumoro AI (optional — chat assistant & AI pricing) ---
# Provider: "gemini" (default) or "openai". Set AI_API_KEY to enable.
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_GEMINI_MODEL="gemini-2.5-flash-lite"
AI_OPENAI_MODEL="gpt-4o-mini"

# --- Backend (Supabase) ---
# Browser-visible (safe to expose, protected by Row Level Security)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side equivalents (used during SSR / server functions)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Privileged server-only key. Required for: payment settlement, expiring stale
# checkout holds, and account deletion.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# --- Payments (UPI) ---
# Business UPI ID shown on the payment QR (e.g. lumoropark@hdfcbank) and the
# business name shown as the payee in the UPI app. Already committed in
# .env.development / .env.production; override here for deployment.
VITE_UPI_ID="your-business@upi"
VITE_UPI_PAYEE_NAME="YOUR BUSINESS NAME"
